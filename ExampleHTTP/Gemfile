source 'https://rubygems.org' do
  gem 'cocoapods', '~> 1.0', '>= 1.16.2'
  gem 'cocoapods-binary', :git => 'https://github.com/mobilecoinofficial/cocoapods-binary.git', :tag => 'v0.4.4.rev5'
  gem 'cocoapods-repo-update'
  gem 'cocoapods-keys'
  # Pinned to a ref rather than `:branch => 'main'`: main has since moved to
  # 2.9.0, so the `2.8.4` requirement became unsatisfiable and any re-resolution
  # (`bundle update`) failed. This ref is the revision both lockfiles already
  # held, so the installed code is unchanged.
  gem 'addressable', '2.8.4', :git => 'https://github.com/sporkmonger/addressable', :ref => 'b56cef3e69bb1294ac4e31dad150e910b05f607f'
  gem 'cocoapods-deintegrate', '~> 1.0', '>= 1.0.4'
  gem 'fastlane'
  # Held at the version ExampleHTTP/Podfile.lock's SPEC CHECKSUMS were generated
  # with. CocoaPods records the SHA1 of the generated
  # Pods/Local Podspecs/*.podspec.json, so a change in JSON.pretty_generate
  # output silently invalidates the lockfile and `pod install --deployment`
  # fails even though no podspec changed.
  gem 'json', '2.6.3'
  gem 'pkg-config'
end
